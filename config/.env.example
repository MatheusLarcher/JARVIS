# MODELO. Copie para `.env` (que NÃO vai pro git) e preencha o que for usar.
# Nada aqui é obrigatório: sem nenhuma chave o JARVIS roda 100% local.

# Provedor de nuvem do agente "avancado" (settings.yml -> nuvem.api_key_env).
# Sem esta chave o agente some da lista sozinho e tudo continua funcionando.
OPENAI_API_KEY=

# Alternativa de nuvem mais barata, se trocar o modelo em settings.yml -> llm.
DEEPSEEK_API_KEY=

# Home Assistant real (settings.yml -> home_assistant.mode: real).
# Com mode: mock, as luzes são simuladas e isto não é usado.
HA_TOKEN=

# Senha do keystore de release do Android (apps/android/*.keystore).
# Só precisa pra gerar APK assinado; o debug não usa.
KEYSTORE_PASSWORD=
